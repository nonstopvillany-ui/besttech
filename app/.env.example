# Besttech app – környezeti változók MINTÁJA.
# Valódi értékeket SOHA ne tegyél a GitHubra! Helyben másold .env néven,
# a Railway-en a szolgáltatás Variables fülén add meg őket.

# PostgreSQL kapcsolat (Railway-en: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://felhasznalo:jelszo@localhost:5432/besttech

# production | development
NODE_ENV=development

# A szerver portja (Railway automatikusan megadja)
PORT=3000

# Az alkalmazás nyilvános címe (cookie- és Origin-ellenőrzéshez)
APP_URL=http://localhost:5173

# Munkamenet élettartama órában (alapérték: 168 = 7 nap)
SESSION_TTL_HOURS=168

# Bejelentkezési kísérletek száma IP-címenként 15 percen belül (alapérték: 10)
LOGIN_RATE_LIMIT=10

# --- Első adminisztrátor létrehozása indításkor (opcionális) ---
# Csak akkor lép életbe, ha még NINCS aktív adminisztrátor az adatbázisban.
# Az első belépéskor kötelező jelszócsere következik.
# Sikeres létrehozás után TÖRÖLD ezt a két változót a Railway-ről!
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
