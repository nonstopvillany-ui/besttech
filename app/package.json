{
  "name": "besttech-app",
  "version": "0.4.0",
  "private": true,
  "description": "Besttech Kft. vállalatirányítási alkalmazás – bejelentkezés és mozaikos főoldal",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "migrate": "node dist/server/cli/migrate.js",
    "migrate:dev": "tsx server/cli/migrate.ts",
    "create-admin": "node dist/server/cli/create-admin.js",
    "create-admin:dev": "tsx server/cli/create-admin.ts",
    "db:inspect": "node dist/server/cli/db-inspect.js",
    "db:inspect:dev": "tsx server/cli/db-inspect.ts",
    "legacy:check": "tsx server/cli/legacy-check.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
